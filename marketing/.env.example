# Copia a <MK_HOME>/.env (marketing/_state/.env por defecto; fuera de git) y rellena. NUNCA subas el fichero real.
# Solo se usa en backend / terminal / tareas programadas, jamas en el navegador.
OPENAI_API_KEY=
# Modelo de imagen GPT Image vigente (se configura aqui, no esta fijado en el codigo). DALL-E se rechaza salvo OPENAI_IMAGE_ALLOW_LEGACY=1.
OPENAI_IMAGE_MODEL=
# Opcional: modelo con vision para el critico visual (puntua artefactos de IA). Sin el, se usa solo la puntuacion programatica.
OPENAI_VISION_MODEL=
