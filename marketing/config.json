{
  "brand": {
    "name": "Aitor Soluciones",
    "tagline": "Jardinería y propiedades · Les Cases d'Alcanar",
    "web": "aitorsoluciones.com",
    "phoneDisplay": "603 207 780",
    "cta": "Envíanos fotos y ubicación por WhatsApp",
    "colors": {
      "navy": "#071e3b",
      "navy2": "#0b2d56",
      "orange": "#c44d0a",
      "orangeLight": "#f36a10",
      "cream": "#fdfbf8",
      "ink": "#122033",
      "white": "#ffffff"
    },
    "logo": "src/assets/img/logo-aitor-soluciones.png"
  },
  "drive": {
    "folders": {
      "new": {
        "name": "00_NUEVOS_TRABAJOS"
      },
      "processed": {
        "name": "01_PROCESADOS"
      },
      "published": {
        "name": "02_PUBLICADOS"
      },
      "rejected": {
        "name": "03_DESCARTADOS"
      },
      "brand": {
        "name": "04_MATERIAL_MARCA"
      }
    },
    "stateFolder": {
      "NEW": "new",
      "REVIEWED": "processed",
      "READY": "processed",
      "SCHEDULED": "processed",
      "PUBLISHED": "published",
      "REJECTED": "rejected",
      "ARCHIVED": "rejected"
    }
  },
  "inbox": {
    "localMirror": null,
    "archiveDir": "../fotos antes y despues"
  },
  "channels": {
    "instagram": {
      "formats": [
        "feed",
        "story",
        "carousel"
      ],
      "captionMax": 2200,
      "hashtagsMax": 8
    },
    "facebook": {
      "formats": [
        "feed"
      ],
      "captionMax": 2000,
      "hashtagsMax": 5
    },
    "gbp": {
      "formats": [
        "gbp"
      ],
      "captionMax": 1500,
      "hashtagsMax": 0,
      "ctaButton": "CALL"
    }
  },
  "cadence": {
    "timezone": "Europe/Madrid",
    "slots": [
      {
        "day": "mon",
        "time": "10:00",
        "role": "produccion + primera publicacion",
        "channels": [
          "instagram",
          "facebook"
        ]
      },
      {
        "day": "wed",
        "time": "10:00",
        "role": "segunda revision + publicacion",
        "channels": [
          "instagram",
          "gbp"
        ]
      },
      {
        "day": "fri",
        "time": "12:00",
        "role": "cierre + preparacion de la semana siguiente",
        "channels": []
      }
    ],
    "minBufferWeeks": 4,
    "maxWorkPiecesPerWeek": 1
  },
  "reuse": {
    "cooldownDays": 120,
    "newAngleCooldownDays": 45,
    "requireNewAngle": true,
    "nearDuplicateHamming": 6
  },
  "hashtags": {
    "base": [
      "#AitorSoluciones",
      "#LesCasesDAlcanar"
    ],
    "jardineria": [
      "#jardineria",
      "#mantenimientodejardines"
    ],
    "desbroce": [
      "#desbroce",
      "#limpiezadeparcelas"
    ],
    "poda": [
      "#poda",
      "#mantenimientoexterior"
    ],
    "mantenimiento": [
      "#mantenimientodepropiedades"
    ],
    "propiedades": [
      "#mantenimientodepropiedades",
      "#segundaresidencia"
    ],
    "segundas-residencias": [
      "#segundaresidencia",
      "#casaenlacosta"
    ],
    "faq": [
      "#presupuesto"
    ],
    "consejo": [
      "#consejos"
    ],
    "local": [
      "#Alcanar",
      "#TerresDeLEbre"
    ],
    "estacional": [
      "#jardineria"
    ]
  },
  "guardrails": {
    "forbiddenPatterns": [
      "\\d+\\s?(€|euros?)",
      "desde\\s+\\d+",
      "\\bgratis\\b",
      "gratuito",
      "garantizad",
      "\\b100\\s?%",
      "el mejor",
      "los mejores",
      "m[aá]s de \\d+ (a[nñ]os|clientes|trabajos)",
      "\\d+ rese[nñ]as",
      "cumple (con )?la normativa",
      "sin compromiso"
    ],
    "placeIgnore": [
      "Aitor",
      "Aitor Soluciones",
      "Google",
      "WhatsApp",
      "Instagram",
      "Facebook",
      "Alcanar",
      "Les Cases d'Alcanar"
    ]
  },
  "media": {
    "_comment": "URLs HTTPS publicas de las piezas READY_TO_PUBLISH (Instagram y Google Business las exigen). Rama huerfana 'media' del mismo repositorio (sin historial comun con main, no entra en el build de la web), servida por raw.githubusercontent.com. Alternativa: provider 'netlify' si el sitio tiene activados los branch deploys de 'media'. Se purga solo (retentionDays).",
    "provider": "github-raw",
    "branch": "media",
    "netlifySite": "aitorsoluciones",
    "prefix": "m",
    "retentionDays": 30
  },
  "work": {
    "_comment": "Work/ChatGPT consume la cola con sus conectores (escritura ya disponible) y confirma con `mk work done`. Los ids de cuenta viven en <estado>/config.local.json (work.accounts), no en git.",
    "connectors": {
      "facebook": { "app": "Facebook organico", "single": "create_photo_post" },
      "instagram": { "app": "Instagram", "single": "create_image_post", "carousel": "create_carousel_post", "story": "create_story" },
      "gbp": { "app": "Google Business Profile", "single": "create_local_post" }
    },
    "aheadDays": 0
  },
  "cleanup": {
    "_comment": "Retencion y mantenimiento (mk cleanup). Nunca toca fotos reales, material de marca, textos, briefs, calendario, metricas, ledger ni piezas publicadas.",
    "rejectedDays": 7,
    "graceHours": 1,
    "testTempHours": 2,
    "keepReports": 10
  },
  "imageEngine": {
    "_comment": "Motor visual (OpenAI Images API). Modelo y clave SOLO por variables de entorno: OPENAI_IMAGE_MODEL, OPENAI_API_KEY (opcional OPENAI_VISION_MODEL para el critico).",
    "defaults": {
      "variants": 2,
      "maxVariants": 3,
      "quality": "medium",
      "outputFormat": "png"
    },
    "costUsdPer1024Square": {
      "low": 0.006,
      "medium": 0.05,
      "high": 0.21
    },
    "costNote": "Estimacion editable (precios publicos de gpt-image-2 por imagen 1024x1024; escala con los pixeles). Comprueba la tarifa vigente en platform.openai.com.",
    "monthlyBudgetUsd": 20,
    "perBriefBudgetUsd": 2,
    "sizes": {
      "flexibleMultiple": 16,
      "minPixels": 655360,
      "maxPixels": 8294400,
      "maxSide": 3840,
      "maxRatio": 3,
      "fixedFallback": [
        "1024x1024",
        "1024x1536",
        "1536x1024"
      ]
    },
    "targets": {
      "feed": [
        1080,
        1350
      ],
      "story": [
        1080,
        1920
      ],
      "gbp": [
        1200,
        900
      ],
      "web": [
        1600,
        900
      ]
    },
    "generationSize": {
      "4:5": [
        1088,
        1360
      ],
      "9:16": [
        1088,
        1920
      ],
      "1:1": [
        1024,
        1024
      ],
      "4:3": [
        1216,
        912
      ],
      "16:9": [
        1280,
        720
      ],
      "3:2": [
        1536,
        1024
      ],
      "2:3": [
        1024,
        1536
      ]
    },
    "thresholds": {
      "maxMeanSaturation": 0.52,
      "minSharpness": 6,
      "maxTechHueShare": 0.18,
      "minContrast": 28,
      "minScore": 60
    },
    "auto": {
      "_comment": "Generacion automatica de imagen para piezas evergreen proximas (lo lanza `mk auto run`). Limitada por maxPerRun y por los presupuestos.",
      "enabled": true,
      "aheadDays": 7,
      "maxPerRun": 2,
      "maxAttempts": 2,
      "quality": "medium",
      "variants": 2
    },
    "critic": {
      "_comment": "Critico visual (OPENAI_VISION_MODEL). Se ejecuta sobre el fondo y sobre la pieza ya compuesta. Sin critico la pieza queda con autoPublish:false (solo revision humana).",
      "requireForAuto": true,
      "minScore": 70,
      "maxAiLook": 6,
      "costUsdPerCall": 0.003
    },
    "disclosure": {
      "_comment": "Transparencia sin deteriorar el marketing: foto real y composicion/ilustracion evidente no llevan etiqueta; la imagen generada que pueda confundirse con una fotografia lleva 'Ilustracion' discreta dentro de la imagen. Siempre se registra aiGenerated, modelo, prompt y fecha.",
      "label": "Ilustración",
      "extended": "Ampliada con IA"
    }
  }
}
