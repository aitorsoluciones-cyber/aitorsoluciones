---
title: "Jardinería y mantenimiento de propiedades en Alcanar | Aitor Soluciones"
description: "Jardinería, desbroce, poda y mantenimiento de propiedades en Alcanar, La Ràpita, Amposta, Vinaròs y La Sénia. Envía fotos por WhatsApp y recibe una valoración clara."
hreflangEs: "/"
hreflangEn: "/en/property-maintenance/"
layout: layouts/base.njk
---
{% import "components/hero.njk" as heroc %}
{% import "components/cards.njk" as cardsc %}
{% import "components/media.njk" as mediac %}
{% import "components/trust.njk" as trustc %}
{% import "components/faq.njk" as faqc %}
{% import "components/cta.njk" as ctac %}
{% import "components/areas.njk" as areasc %}
{% import "components/form.njk" as formc %}
{% import "components/jsonld.njk" as ld %}

{% set waLinkHome = business.whatsapp | waLink(business.waMessageDefault) %}
{% set jardineria = services | findById("jardineria") %}
{% set mantProp = services | findById("mantenimiento-propiedades") %}
{% set homeFaqIds = ["fotos-precio", "restos-incluidos", "info-enviar", "mantenimiento-posterior", "vive-lejos"] %}
{% set homeFaqs = homeFaqIds | pickByIds(faqs) %}

<script type="application/ld+json">{{ ld.faqSchema(homeFaqs) | safe }}</script>

{% set quickLinks = ["jardineria", "desbroce-parcelas", "poda-mantenimiento-exterior", "mantenimiento-segundas-residencias", "limpieza-viviendas", "pintura", "reparaciones-hogar"] | pickByIds(services) %}
{{ heroc.homeHero(business, waLinkHome, quickLinks) }}

<section class="section" id="resultados"><div class="container">
<div class="section-head"><span class="eyebrow">Resultados reales</span><h2>Lo que más convence es ver el cambio</h2><p>Fotografías reales de antes y después, sin imágenes de stock para simular resultados.</p></div>
{{ mediac.beforeAfter("jardin-olivos-antes", "jardin-olivos-despues", "Jardín con olivos antes de la puesta a punto", "Jardín con olivos después de la puesta a punto", "Lo dejamos cuidado y más fácil de mantener.", true) }}
<div class="trust-row" style="margin-top:28px;justify-content:center">
<span class="trust-pill">Trabajo local</span>
<span class="trust-pill">Fotos reales</span>
<span class="trust-pill">Presupuesto antes de empezar</span>
<span class="trust-pill">Mantenimiento periódico</span>
</div>
</div></section>

<section class="section section-soft" id="servicios"><div class="container">
<div class="section-head"><span class="eyebrow">Servicio principal</span><h2>Jardinería: mantenimiento, desbroce y poda</h2><p>La mayoría de clientes nos escriben porque el jardín o la finca se les ha ido de las manos, viven lejos o no tienen tiempo ni maquinaria para recuperarla. Estos son los trabajos en los que nos centramos.</p></div>
{{ cardsc.serviceIndex(jardineria.childServiceIds | pickByIds(services)) }}
<p style="margin-top:22px"><a href="/jardineria/">Ver toda la jardinería →</a></p>
</div></section>

<section class="section"><div class="container">
<div class="section-head"><span class="eyebrow">Vivienda y propiedades</span><h2>{{ mantProp.name }}</h2><p>{{ mantProp.intro }}</p></div>
{{ cardsc.serviceIndex(mantProp.childServiceIds | pickByIds(services)) }}
<p style="margin-top:22px"><a href="{{ mantProp.url }}">Ver mantenimiento de propiedades →</a></p>
</div></section>

<section class="section section-soft" id="trabajos"><div class="container">
<div class="section-head"><span class="eyebrow">Trabajos reales</span><h2>Fotografías reales de trabajos realizados</h2><p>Una selección de antes y después. Puedes ver más en la página de trabajos.</p></div>
{{ mediac.workGallery(publishedCases, locations) }}
<div class="cta-row"><a class="btn btn-primary" href="/trabajos/">Ver todos los trabajos →</a></div>
</div></section>

<section class="section section-dark"><div class="container">
<div class="section-head"><span class="eyebrow">Cómo trabajamos</span><h2>Lo ponemos a punto y podemos mantenerlo</h2><p>Para que no vuelva a descontrolarse, acordamos visitas puntuales o periódicas después del primer trabajo.</p></div>
{{ trustc.process(business.defaultProcessSteps) }}
</div></section>

<section class="section"><div class="container">
<div class="section-head"><span class="eyebrow">Confianza y zona</span><h2>Comprueba cómo trabajamos antes de contratar</h2><p>El perfil de Google muestra las opiniones publicadas por clientes, fotografías y los datos de contacto del negocio. Trabajamos con base en {{ business.base }} y desplazamientos normalmente dentro de un radio aproximado de {{ business.serviceRadiusKm }} km.</p></div>
{{ trustc.reviewsTrust(business.googleMapsUrl) }}
<div style="margin-top:34px">{{ areasc.priorityAreas(locations) }}</div>
<p style="margin-top:18px"><a href="/zonas/">Ver todas las zonas atendidas →</a></p>
</div></section>

<section class="section section-soft"><div class="container">
<div class="section-head"><span class="eyebrow">Preguntas frecuentes</span><h2>Lo que necesitas saber antes de pedir presupuesto</h2></div>
{{ faqc.faqList(homeFaqs) }}
</div></section>

<section class="section section-soft" id="contacto"><div class="container contact-box">
<div>
<span class="eyebrow">Pide valoración</span><h2>{{ business.ctaSupportMessage }}</h2>
<div class="cta-row">{{ ctac.whatsappCta(waLinkHome, "Abrir WhatsApp", "home_final") }}{{ ctac.phoneCta(business.phone, business.phoneDisplay, "home_final") }}</div>
</div>
{{ formc.leadForm("", "", legal) }}
</div></section>
