{% macro trustBar(items) %}
<div class="trust-row">
{% for item in items %}<span class="trust-pill">{{ item }}</span>{% endfor %}
</div>
{% endmacro %}

{% macro process(steps) %}
<ol class="timeline">
{% for step in steps %}
<li class="timeline-step"><span class="timeline-num">{{ "0" + loop.index if loop.index < 10 else loop.index }}</span><div><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div></li>
{% endfor %}
</ol>
{% endmacro %}

{% macro reviewsTrust(googleMapsUrl) %}
<div class="quote">
<strong class="stars-line">Opiniones de clientes en Google</strong>
<p>Consulta las opiniones publicadas por clientes y las fotografías de trabajos realizados en el perfil de Google.</p>
<a class="btn btn-secondary" href="{{ googleMapsUrl }}" target="_blank" rel="noopener">Ver perfil y reseñas</a>
</div>
{% endmacro %}
