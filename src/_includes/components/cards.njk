{% macro serviceCard(service) %}
<article class="card service-card">
<div class="icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg></div>
<h3>{{ service.name }}</h3>
<p>{{ service.metaDescription or service.problem }}</p>
<a href="{{ service.url }}">Ver {{ service.name | lower }} →</a>
</article>
{% endmacro %}

{% macro locationCard(location) %}
{% if location.hasLandingPage %}
<a class="area-card" href="{{ location.url }}"><h3>{{ location.name }}</h3><p>Jardinería, desbroce y mantenimiento.</p><span>Ver servicio →</span></a>
{% else %}
<div class="area-card" style="cursor:default"><h3>{{ location.name }}</h3><p>Zona atendida · {{ location.province }}</p></div>
{% endif %}
{% endmacro %}
