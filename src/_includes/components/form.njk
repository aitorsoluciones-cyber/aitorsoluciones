{% macro leadForm(defaultService, defaultLocation) %}
<form name="presupuesto" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/gracias/">
<input type="hidden" name="form-name" value="presupuesto">
<input type="hidden" name="utm" value="">
<input type="hidden" name="pagina" value="">
<input type="hidden" name="fuente" value="web">
<p hidden><label>No rellenar: <input name="bot-field"></label></p>
<div class="form-grid"><div><label for="nombre">Nombre</label><input id="nombre" name="nombre" autocomplete="name" required></div><div><label for="telefono">Teléfono</label><input id="telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" required></div></div>
<div class="form-grid"><div><label for="email">Email (opcional)</label><input id="email" name="email" type="email" autocomplete="email"></div><div><label for="zona">Localidad</label><input id="zona" name="zona" placeholder="Alcanar, Vinaròs..." value="{{ defaultLocation or '' }}" required></div></div>
<div class="form-grid">
<div><label for="tipo">Servicio</label><select id="tipo" name="tipo">
<option {% if defaultService == "Jardinería / mantenimiento de jardines" or not defaultService %}selected{% endif %}>Jardinería / mantenimiento de jardines</option>
<option {% if defaultService == "Desbroce de parcela o solar" %}selected{% endif %}>Desbroce de parcela o solar</option>
<option {% if defaultService == "Poda y mantenimiento exterior" %}selected{% endif %}>Poda y mantenimiento exterior</option>
<option {% if defaultService == "Mantenimiento de propiedades" %}selected{% endif %}>Mantenimiento de propiedades</option>
<option {% if defaultService == "Segunda residencia" %}selected{% endif %}>Segunda residencia</option>
<option>Otro</option>
</select></div>
<div><label for="metros">Metros aproximados</label><input id="metros" name="metros" placeholder="Ej. 600 m²"></div>
</div>
<div class="form-grid"><div><label for="fecha">Fecha orientativa</label><input id="fecha" name="fecha" placeholder="Ej. este mes, antes del verano..."></div><div><label for="restos">¿Qué hacemos con los restos?</label><select id="restos" name="restos"><option>Agrupar dentro de la parcela</option><option>Retirar (se valora aparte)</option><option>No lo sé todavía</option></select></div></div>
<label for="necesidad">¿Qué necesitas?</label>
<textarea id="necesidad" name="necesidad" placeholder="Cuéntanos brevemente qué necesitas..."></textarea>
<label><input type="checkbox" name="prefiere-whatsapp" value="Sí" style="width:auto"> Prefiero enviar las fotos por WhatsApp</label>
<label><input type="checkbox" required style="width:auto"> Acepto la <a href="/politica-privacidad/">política de privacidad</a>.</label>
<button class="btn btn-primary" type="submit">Enviar consulta</button>
</form>
{% endmacro %}
