{% macro siteFooter(business, waLink, locations) %}
<footer class="site-footer"><div class="container footer-grid">
<div><img class="footer-logo" src="{{ business.logo }}" alt="{{ business.name }}" width="500" height="154"><p>Jardinería y mantenimiento de propiedades en Alcanar y alrededores. Trabajo local, trato directo y presupuesto claro.</p></div>
<div><h3>Contacto</h3><p><a href="tel:{{ business.phone }}">{{ business.phoneDisplay }}</a><br><a href="{{ waLink }}" target="_blank" rel="noopener">WhatsApp</a><br><a href="mailto:{{ business.email }}">{{ business.email }}</a></p></div>
<div><h3>Servicios</h3><p><a href="/jardineria/">Jardinería</a><br><a href="/mantenimiento-jardines/">Mantenimiento de jardines</a><br><a href="/desbroce-parcelas/">Desbroce y parcelas</a><br><a href="/poda-mantenimiento-exterior/">Poda y exterior</a><br><a href="/mantenimiento-propiedades/">Mantenimiento de propiedades</a><br><a href="/mantenimiento-segundas-residencias/">Segundas residencias</a><br><a href="/limpieza-viviendas/">Limpieza de viviendas</a><br><a href="/pintura/">Pintura</a><br><a href="/reparaciones-hogar/">Pequeñas reparaciones</a></p></div>
<div><h3>Zona</h3><p>{% if locations %}{% for loc in locations %}{% if loc.isPriority %}{% if loc.hasLandingPage %}<a href="{{ loc.url }}">{{ loc.name }}</a>{% else %}{{ loc.name }}{% endif %}<br>{% endif %}{% endfor %}{% endif %}<a href="/zonas/">Ver todas las zonas →</a></p></div>
</div>
<div class="container footer-legal">
