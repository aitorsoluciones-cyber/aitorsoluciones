{% macro siteHeader(business, services, waLink, currentUrl) %}
<div class="topbar"><div class="container topbar-inner">
<span>{{ business.base }} · Servicio local hasta {{ business.serviceRadiusKm }} km</span>
<a href="tel:{{ business.phone }}" data-lead="phone" data-source="topbar">{{ business.phoneDisplay }}</a>
</div></div>
<header class="site-header"><div class="container nav">
<a class="logo" href="/" aria-label="{{ business.name }}, inicio">
<img src="{{ business.logo }}" alt="{{ business.name }}" width="500" height="154">
<span class="logo-tag">Jardinería y propiedades<br>{{ business.base }}</span>
</a>
<button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
<nav class="nav-links" aria-label="Navegación principal">
<a href="/"{% if currentUrl == "/" %} class="is-active" aria-current="page"{% endif %}>Inicio</a>
<div class="nav-dropdown">
<a href="/jardineria/"{% if currentUrl == "/jardineria/" %} class="is-active" aria-current="page"{% endif %}>Jardinería</a>
<div class="nav-dropdown-panel">
{% for s in services %}{% if s.parentId == "jardineria" %}<a href="{{ s.url }}">{{ s.navLabel }}</a>{% endif %}{% endfor %}
</div>
</div>
<div class="nav-dropdown">
<a href="/mantenimiento-propiedades/"{% if currentUrl == "/mantenimiento-propiedades/" %} class="is-active" aria-current="page"{% endif %}>Servicios</a>
<div class="nav-dropdown-panel">
<a href="/mantenimiento-propiedades/">Mantenimiento de propiedades</a>
{% for s in services %}{% if s.parentId == "mantenimiento-propiedades" and s.status == "active" %}<a href="{{ s.url }}">{{ s.navLabel }}</a>{% endif %}{% endfor %}
</div>
</div>
<a href="/zonas/"{% if currentUrl == "/zonas/" %} class="is-active" aria-current="page"{% endif %}>Zonas</a>
<a href="/trabajos/"{% if currentUrl == "/trabajos/" %} class="is-active" aria-current="page"{% endif %}>Trabajos</a>
<a href="/contacto/"{% if currentUrl == "/contacto/" %} class="is-active" aria-current="page"{% endif %}>Contacto</a>
<a class="lang-link" href="/en/property-maintenance/">EN</a>
<a class="btn btn-header" href="{{ waLink }}" target="_blank" rel="noopener" data-lead="whatsapp" data-source="header">{{ business.ctaPrimaryLabel }}</a>
</nav>
</div></header>
{% endmacro %}

{% macro siteHeaderEn(business, services, waLink, currentUrl) %}
<div class="topbar"><div class="container topbar-inner">
<span>{{ business.base }} · Local service up to {{ business.serviceRadiusKm }} km</span>
<a href="tel:{{ business.phone }}" data-lead="phone" data-source="topbar">{{ business.phoneDisplay }}</a>
</div></div>
<header class="site-header"><div class="container nav">
<a class="logo" href="/en/property-maintenance/" aria-label="{{ business.name }}, home">
<img src="{{ business.logo }}" alt="{{ business.name }}" width="500" height="154">
<span class="logo-tag">Gardens &amp; properties<br>{{ business.base }}</span>
</a>
<button class="menu-toggle" aria-label="Open menu" aria-expanded="false"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
<nav class="nav-links" aria-label="Main navigation">
<a href="/en/property-maintenance/#services">Services</a>
<a href="/en/property-maintenance/#results">Results</a>
<a href="/en/property-maintenance/#faq">FAQ</a>
<a class="lang-link" href="/">ES</a>
<a class="btn btn-header" href="{{ waLink }}" target="_blank" rel="noopener" data-lead="whatsapp" data-source="header">Send photos on WhatsApp</a>
</nav>
</div></header>
{% endmacro %}

{% macro siteFooterEn(business, waLink, locations) %}
<footer class="site-footer"><div class="container footer-grid">
<div><img class="footer-logo" src="{{ business.logo }}" alt="{{ business.name }}" width="500" height="154"><p>Garden and property maintenance. Local service, direct contact and clear quotes.</p></div>
<div><h3>Contact</h3><p><a href="tel:{{ business.phone }}">{{ business.phoneDisplay }}</a><br><a href="{{ waLink }}" target="_blank" rel="noopener">WhatsApp</a><br><a href="mailto:{{ business.email }}">{{ business.email }}</a></p></div>
<div><h3>Services</h3><p><a href="/mantenimiento-segundas-residencias/">Second home maintenance (ES)</a><br><a href="/jardineria/">Jardinería (ES)</a></p></div>
<div><h3>Area</h3><p>{{ business.base }}{% if locations %}{% for loc in locations %}{% if loc.isPriority %}<br>{{ loc.name }}{% endif %}{% endfor %}{% endif %}</p></div>
</div>
<div class="container footer-legal">
<span>© {% year %} {{ business.name }}</span>
<a href="/">Español</a>
<a href="/politica-privacidad/">Privacy policy (ES)</a>
<a href="/aviso-legal/">Legal notice (ES)</a>
<a href="/sitemap.xml">Sitemap</a>
</div></footer>
<a class="mobile-cta" href="{{ waLink }}" target="_blank" rel="noopener" data-lead="whatsapp" data-source="mobile_sticky" aria-hidden="true" tabindex="-1"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>Send photos</a>
