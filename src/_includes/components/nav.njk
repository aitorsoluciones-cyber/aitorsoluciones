{% macro siteHeader(business, services, waLink) %}
<div class="topbar"><div class="container topbar-inner">
<span>{{ business.base }} · Servicio local hasta {{ business.serviceRadiusKm }} km</span>
<a href="tel:{{ business.phone }}" data-lead="phone" data-source="topbar">{{ business.phoneDisplay }}</a>
</div></div>
<header class="site-header"><div class="container nav">
<a class="logo" href="/" aria-label="{{ business.name }}, inicio"><img src="{{ business.logo }}" alt="{{ business.name }}" width="500" height="154"></a>
<button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
<nav class="nav-links" aria-label="Navegación principal">
<a href="/">Inicio</a>
<div class="nav-dropdown">
<a href="/jardineria/">Jardinería</a>
<div class="nav-dropdown-panel">
{% for s in services %}{% if s.parentId == "jardineria" %}<a href="{{ s.url }}">{{ s.navLabel }}</a>{% endif %}{% endfor %}
</div>
</div>
<div class="nav-dropdown">
<a href="/mantenimiento-propiedades/">Servicios</a>
<div class="nav-dropdown-panel">
<a href="/mantenimiento-propiedades/">Mantenimiento de propiedades</a>
{% for s in services %}{% if s.parentId == "mantenimiento-propiedades" and s.status == "active" %}<a href="{{ s.url }}">{{ s.navLabel }}</a>{% endif %}{% endfor %}
</div>
</div>
<a href="/zonas/">Zonas</a>
<a href="/trabajos/">Trabajos</a>
<a href="/contacto/">Contacto</a>
<a class="lang-link" href="/en/property-maintenance/">EN</a>
<a class="btn btn-primary" href="{{ waLink }}" target="_blank" rel="noopener" data-lead="whatsapp" data-source="header">{{ business.ctaPrimaryLabel }}</a>
</nav>
</div></header>
{% endmacro %}

{% macro siteFooter(business, waLink) %}
<footer><div class="container footer-grid">
<div><img class="footer-logo" src="{{ business.logo }}" alt="{{ business.name }}" width="500" height="154"><p>Jardinería y mantenimiento de propiedades en Alcanar y alrededores. Trabajo local, trato directo y presupuesto claro.</p></div>
<div><h3>Servicios</h3><p><a href="/jardineria/">Jardinería</a><br><a href="/mantenimiento-jardines/">Mantenimiento de jardines</a><br><a href="/desbroce-parcelas/">Desbroce y parcelas</a><br><a href="/mantenimiento-propiedades/">Mantenimiento de propiedades</a></p></div>
<div><h3>Contacto</h3><p><a href="tel:{{ business.phone }}">{{ business.phoneDisplay }}</a><br><a href="mailto:{{ business.email }}">{{ business.email }}</a><br>{{ business.base }}</p></div>
<div><h3>Información</h3><p><a href="/zonas/">Zonas</a><br><a href="/politica-privacidad/">Privacidad</a><br><a href="/aviso-legal/">Aviso legal</a><br><a href="/sitemap.xml">Sitemap</a><br><a href="https://academy.aitorsoluciones.com/">Aitor Academy</a></p></div>
</div></footer>
<div class="mobile-bar">
<a class="btn btn-secondary" href="tel:{{ business.phone }}" data-lead="phone" data-source="mobile_bar">Llamar</a>
<a class="btn btn-whatsapp" href="{{ waLink }}" target="_blank" rel="noopener" data-lead="whatsapp" data-source="mobile_bar">WhatsApp</a>
</div>
{% endmacro %}
