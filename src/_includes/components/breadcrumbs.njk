{% macro breadcrumbs(items) %}
<nav class="breadcrumbs" aria-label="Migas de pan">
{% for item in items %}{% if not loop.last %}<a href="{{ item.url }}">{{ item.label }}</a><span aria-hidden="true">/</span>{% else %}<span aria-current="page">{{ item.label }}</span>{% endif %}{% endfor %}
</nav>
{% endmacro %}
