{% macro priorityAreas(locations) %}
<div class="local-strip">
{% for loc in locations %}{% if loc.hasLandingPage %}
<a class="local-strip-item" href="{{ loc.url }}">{{ loc.name }}<span aria-hidden="true">→</span></a>
{% endif %}{% endfor %}
<a class="local-strip-item" href="/en/property-maintenance/">Foreign property owners<span aria-hidden="true">→</span></a>
</div>
{% endmacro %}

{% macro provinceList(locations, province) %}
<div class="zone-chips">
{% for loc in locations %}{% if loc.province == province %}
{% if loc.hasLandingPage %}<a href="{{ loc.url }}" style="text-decoration:none"><span>{{ loc.name }}</span></a>{% else %}<span>{{ loc.name }}</span>{% endif %}
{% endif %}{% endfor %}
</div>
{% endmacro %}
